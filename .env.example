# Canonical public origin. Never use localhost or a Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://www.mikechaves.io

# Optional token supplied by Google Search Console. Keep the real value in Vercel, not Git.
GOOGLE_SITE_VERIFICATION=

# Server-only key used by Adaptive Focus custom role analysis.
OPENAI_API_KEY=

# Optional. Defaults to the current cost-efficient structured-output model.
OPENAI_ADAPTIVE_FOCUS_MODEL=gpt-5-mini

# Optional contact-form delivery.
RESEND_API_KEY=
