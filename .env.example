# Canonical public origin. Never use localhost or a Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://www.mikechaves.io

# Optional token supplied by Google Search Console. Keep the real value in Vercel, not Git.
GOOGLE_SITE_VERIFICATION=

# Public GA4 measurement ID. Configure in Vercel Production only (example shape: G-XXXXXXXXXX).
# Google Analytics remains unloaded until the visitor grants optional analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local-only verification path. Never set to 1 in Vercel Production.
# Captures sanitized events in window.__portfolioAnalyticsDebugEvents with no provider requests.
NEXT_PUBLIC_ANALYTICS_DEBUG=0

# Server-only key used by Adaptive Focus custom role analysis.
OPENAI_API_KEY=

# Optional. Defaults to the current cost-efficient structured-output model.
OPENAI_ADAPTIVE_FOCUS_MODEL=gpt-5-mini

# Optional contact-form delivery.
RESEND_API_KEY=
